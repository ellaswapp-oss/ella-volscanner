# =============================================================================
# Vol Dashboard — Backend Environment Variables (EXAMPLE)
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example IS committed to document required variables.

# ---------------------------------------------------------------------------
# Data Provider
# ---------------------------------------------------------------------------
# mock  — fully synthetic, no network calls (default, safe for development/CI)
# real  — live data from Polygon, ORATS, FRED, CBOE
DATA_PROVIDER=mock

# ---------------------------------------------------------------------------
# API Keys (only needed when DATA_PROVIDER=real)
# ---------------------------------------------------------------------------

# Polygon.io — prices and options chains
# Docs: https://polygon.io/docs/options/getting-started
# Key:  https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# ORATS — IV history (constant-maturity surface: iv7, iv30, iv60, iv90)
# Docs: https://docs.orats.io/datav2-api-guide/
# Key:  https://orats.com/account
ORATS_API_KEY=your_orats_api_key_here

# FRED — macro series (VIXCLS, BAMLH0A0HYM2, T10Y2Y, NFCI)
# Docs: https://fred.stlouisfed.org/docs/api/fred/
# Key:  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
